# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:REPLACE_ME

# Адрес запущенного Spring Boot сервиса (без завершающего слеша)
API_BASE_URL=http://localhost:8080

# Telegram ID администраторов через запятую. Узнать свой ID можно у @userinfobot
ADMIN_IDS=123456789

# Ключ для административных операций бэкенда. Должен совпадать с ADMIN_API_KEY
# в окружении, где запущен Spring Boot. Если не задан, управление предметами
# преподавателя будет недоступно.
ADMIN_API_KEY=change-me

# Локальная база бота: привязки Telegram -> studentId и созданные через бота записи
DATABASE_PATH=data/bot.sqlite3

# Таймаут запросов к бэкенду, секунды
REQUEST_TIMEOUT=10

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
